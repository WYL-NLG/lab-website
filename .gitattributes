# Auto detect text files and perform LF normalization
* text=auto

# JavaScript/TypeScript files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# HTML/CSS files
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# Markdown files
*.md text eol=lf

# JSON files
*.json text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.webp binary
*.woff2 binary
*.woff binary
*.ttf binary
*.eot binary